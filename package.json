{
  "name": "dig-wikimedica-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned documentation tooling for CI (Markdown lint, spell check). Contains no runtime code.",
  "scripts": {
    "lint:md": "markdownlint --config .markdownlint.json \"**/*.md\" --ignore node_modules --ignore .git",
    "spell": "cspell --config .cspell.json --no-progress \"**/*.md\""
  },
  "devDependencies": {
    "@cspell/dict-de-de": "4.1.3",
    "@cspell/dict-medicalterms": "4.1.9",
    "cspell": "10.3.6",
    "markdownlint-cli": "0.49.1"
  }
}
